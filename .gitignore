# Asagidakiler o kaynaklardan freecadcmd ile yeniden uretilebilir (24 MB).
cad/eski_tasarimlar/**/*.step
cad/eski_tasarimlar/**/*.brep
cad/eski_tasarimlar/**/*.npz

