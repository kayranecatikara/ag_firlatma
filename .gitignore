# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- Derleme ciktisi (kaynaktan uretiliyor: gazebo/plugin/AgFizik.cc) ----
gazebo/plugin/build/

# ---- Ham simulasyon ciktilari (buyuk, kos.sh ile yeniden uretilir) ----
out/gazebo_*.csv
out/gazebo_poz.txt
out/gazebo_v5_poz.txt
out/*.npy
out/*.npz
# ISTISNA: x_final.npy TASARIM VEKTORUDUR, uretilmis bir ara cikti DEGIL.
# run_lastik/run_taret bunsuz calismaz. Bir kez gitignore'da kaldigi icin
# depo yeniden duzenlenirken SILINDI ve analiz zinciri kirildi; yeniden
# kuruldu. Bir daha kaybolmasin diye TAKIP EDILIYOR.
!out/x_final.npy
out/*.log

# ---- FreeCAD ----
*.FCStd1
# .brep FreeCAD ara formatidir; .step zaten var ve tasinabilir
cad/*.brep

# ---- ARSIV: uretilen geometri ----
# cad/eski_tasarimlar/ icindeki .py KAYNAK dosyalari REPO'DA KALIYOR.
# Asagidakiler o kaynaklardan freecadcmd ile yeniden uretilebilir (24 MB).
cad/eski_tasarimlar/**/*.step
cad/eski_tasarimlar/**/*.brep
cad/eski_tasarimlar/**/*.npz

# ---- Isletim sistemi ----
.DS_Store
Thumbs.db

# web/: ara STL dosyalari regenere edilebilir (cad/web_geometri.py)
web/geo/*.stl
